        "default": "mdi:alarm-off",
        "state": {
          "on": "mdi:alarm-check"
        }
      },
      "day_mon": {
        "default": "mdi:calendar-blank-outline",
        "state": {
          "on": "mdi:calendar-check"
        }
      },
      "day_tue": {
        "default": "mdi:calendar-blank-outline",
        "state": {
          "on": "mdi:calendar-check"
        }
      },
      "day_wed": {
        "default": "mdi:calendar-blank-outline",
        "state": {
          "on": "mdi:calendar-check"
        }
      },
      "day_thu": {
        "default": "mdi:calendar-blank-outline",
        "state": {
          "on": "mdi:calendar-check"
        }
      },
      "day_fri": {
        "default": "mdi:calendar-blank-outline",
        "state": {
          "on": "mdi:calendar-check"
        }
      },
      "day_sat": {
        "default": "mdi:calendar-blank-outline",
        "state": {
          "on": "mdi:calendar-check"
        }
      },
      "day_sun": {
        "default": "mdi:calendar-blank-outline",
        "state": {
          "on": "mdi:calendar-check"
        }
      }
    },
    "sensor": {
      "next_alarm": {
        "default": "mdi:alarm"
      },
