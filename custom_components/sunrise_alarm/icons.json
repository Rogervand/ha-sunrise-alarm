{
  "entity": {
    "time": {
      "alarm_time": {
        "default": "mdi:alarm"
      }
    },
    "switch": {
      "enabled": {
        "default": "mdi:alarm-off",
        "state": {
          "on": "mdi:alarm-check"
        }
      }
    },
    "sensor": {
      "next_alarm": {
        "default": "mdi:alarm"
      },
      "status": {
        "default": "mdi:alarm",
        "state": {
          "idle": "mdi:alarm",
          "waking": "mdi:weather-sunset-up",
          "running": "mdi:alarm-light"
        }
      }
    },
    "button": {
      "stop": {
        "default": "mdi:stop-circle-outline"
      },
      "test": {
        "default": "mdi:play-circle-outline"
      }
    }
  },
  "services": {
    "update": {
      "service": "mdi:alarm-plus"
    },
    "stop": {
      "service": "mdi:stop-circle-outline"
    },
    "trigger": {
      "service": "mdi:play-circle-outline"
    }
  }
}
